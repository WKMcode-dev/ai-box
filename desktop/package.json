{
  "name": "@ai-box/desktop",
  "productName": "A.I BOX",
  "version": "1.3.3",
  "private": true,
  "description": "Catálogo de ferramentas digitais e inteligências artificiais com acesso gratuito, incluindo o catálogo atualizado do A.I BOX.",
  "author": "WKMcode-dev",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.wkmcode.aibox",
    "productName": "A.I BOX",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist-desktop",
        "to": "site"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "A.I BOX",
      "artifactName": "AI-BOX-${version}-${arch}-setup.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "AI-BOX-${version}-${arch}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/WKMcode-dev/ai-box/releases/latest/download/",
        "useMultipleRangeRequest": false
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  }
}
